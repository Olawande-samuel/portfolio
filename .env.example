# SMTP settings for the /api/contact endpoint (used by /contact and /work-with-me).
# Copy to .env for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# For Gmail, MAIL_PASSWORD must be an App Password (Google Account → Security → App passwords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_FROM_NAME="Portfolio Contact"
# Optional: deliver enquiries somewhere other than MAIL_FROM_ADDRESS.
# MAIL_TO_ADDRESS=you@example.com
