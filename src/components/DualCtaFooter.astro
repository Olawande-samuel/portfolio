---
import { links } from "../data/site";

interface Props {
	width?: "wrap" | "wrap-md";
}

const { width = "wrap" } = Astro.props;
---

<footer class="footer section">
	<div class={width}>
		<div class="cards">
			<a href="/contact#hiring" class="card hiring">
				<div class="label">Hiring</div>
				<div class="title">Let’s talk about the role →</div>
			</a>
			<a href="/work-with-me" class="card business">
				<div class="label">Business site</div>
				<div class="title">Tell me what you need built →</div>
			</a>
		</div>
		<div class="bottom">
			<span>© 2026 Olawande Samuel Akinmosin</span>
			<a href={`mailto:${links.email}`}>{links.email}</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--border);
		padding-top: 80px;
		padding-bottom: 48px;
	}

	.cards {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}

	.card {
		flex: 1 1 300px;
		display: block;
		padding: 34px;
		border-radius: 12px;
		border: 1px solid oklch(1 0 0 / 0.1);
		color: inherit;
		transition:
			border-color 0.25s ease,
			background-color 0.25s ease;
	}

	.card:hover {
		color: inherit;
	}

	.hiring .label {
		color: var(--coral);
	}

	.hiring:hover {
		border-color: rgba(231, 60, 126, 0.5);
		background: rgba(231, 60, 126, 0.06);
	}

	.business .label {
		color: var(--mint);
	}

	.business:hover {
		border-color: rgba(35, 213, 171, 0.5);
		background: rgba(35, 213, 171, 0.06);
	}

	.title {
		margin-top: 14px;
		font-size: 26px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		justify-content: space-between;
		margin-top: 56px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-faint);
	}

	.bottom a {
		color: inherit;
	}

	.bottom a:hover {
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.card {
			padding: 26px;
		}

		.title {
			font-size: 22px;
		}
	}
</style>
