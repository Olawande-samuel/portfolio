---
import { Image } from "astro:assets";
import PhoneShots from "./PhoneShots.astro";
import type { Project } from "../data/site";

interface Props {
	project: Project;
}

const { project: p } = Astro.props;
---

<article class="card" data-reveal>
	<div class="media">
		{
			p.image ? (
				<Image
					src={p.image}
					alt={`${p.name} screenshot`}
					widths={[480, 720, 1160]}
					sizes="(max-width: 1000px) calc(100vw - 80px), 578px"
					class="shot"
				/>
			) : (
				p.phones && <PhoneShots phones={p.phones} />
			)
		}
		<div class="tag">{p.kind}</div>
	</div>
	<div class="body">
		<div class="head">
			<h3>{p.name}</h3>
			<span class="sector">{p.sector}</span>
		</div>
		<p class="blurb">{p.blurb}</p>
		<div class="row">
			<span class="row-label">Role</span>
			<span>{p.role}</span>
		</div>
		<div class="row result">
			<span class="row-label">Result</span>
			<span>{p.outcome}</span>
		</div>
		<div class="chips stack">
			{p.stack.map((t) => <span class="chip">{t}</span>)}
		</div>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		border-radius: 14px;
		border: 1px solid var(--border);
		background: var(--surface-2);
		overflow: hidden;
	}

	/* Hover lift lives on its own rule so it doesn't fight the reveal transition. */
	.card,
	:global(.js) .card.is-revealed {
		transition:
			border-color 0.3s ease,
			transform 0.3s ease,
			opacity 0.7s var(--ease-out);
	}

	.card:hover {
		border-color: rgba(231, 60, 126, 0.45);
		transform: translateY(-4px);
	}

	.media {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--media-bg);
		overflow: hidden;
	}

	.shot {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	.tag {
		position: absolute;
		top: 14px;
		left: 14px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		padding: 6px 10px;
		border-radius: 999px;
		background: oklch(0.14 0.01 300 / 0.8);
		border: 1px solid var(--border-input);
		color: oklch(0.8 0.02 300);
	}

	.body {
		padding: 28px 28px 30px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		flex: 1;
	}

	.head {
		display: flex;
		align-items: baseline;
		gap: 12px;
	}

	h3 {
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.sector {
		font-family: var(--font-mono);
		font-size: 11px;
		color: oklch(0.58 0.012 300);
	}

	.blurb {
		margin: 0;
		font-size: 15.5px;
		line-height: 1.62;
		color: var(--text-body);
	}

	.row {
		display: flex;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
		color: oklch(0.66 0.012 300);
	}

	.result {
		color: var(--mint);
	}

	.row-label {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: oklch(0.52 0.012 300);
		padding-top: 3px;
		flex-shrink: 0;
	}

	.stack {
		margin-top: auto;
		padding-top: 18px;
		border-top: 1px solid var(--border-soft);
	}

	@media (max-width: 640px) {
		.body {
			padding: 22px 20px 24px;
		}
	}
</style>
