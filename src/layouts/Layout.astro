---
import { getImage } from "astro:assets";
import type { ComponentProps } from "astro/types";
import "../styles/global.css";
import Glow, { type Blob } from "../components/Glow.astro";
import Nav from "../components/Nav.astro";
import portrait from "../assets/portrait.jpg";

interface Props {
	title: string;
	description: string;
	blobs: Blob[];
	theme?: "default" | "mint";
	nav?: ComponentProps<typeof Nav>;
}

const { title, description, blobs, theme = "default", nav = {} } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 1200, format: "jpg" });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en" class={theme === "mint" ? "theme-mint" : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#16131a" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<!-- Marks the page as JS-enabled before first paint so reveal styles only apply when they can be undone. -->
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<Glow blobs={blobs} />
		<div class="page">
			<Nav {...nav} />
			<main>
				<slot />
			</main>
			<slot name="footer" />
		</div>
		<slot name="after" />

		<script>
			const els = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
			const show = (el: HTMLElement) => {
				if (el.classList.contains("is-revealed")) return;
				el.classList.add("is-revealed");
				// Drop the stagger once revealed so hover transitions respond immediately.
				setTimeout(() => (el.style.transitionDelay = ""), 900);
			};

			els.forEach((el, i) => {
				el.style.transitionDelay = `${(i % 4) * 60}ms`;
			});

			if (!("IntersectionObserver" in window)) {
				els.forEach(show);
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								show(entry.target as HTMLElement);
								io.unobserve(entry.target);
							}
						});
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
				);
				els.forEach((el) => io.observe(el));
				// Safety net: never leave content hidden.
				setTimeout(() => els.forEach(show), 2500);
			}
		</script>
	</body>
</html>

<style>
	.page {
		position: relative;
		z-index: 1;
	}
</style>
