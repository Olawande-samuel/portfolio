---
import Layout from "../layouts/Layout.astro";
import Field from "../components/Field.astro";
import Honeypot from "../components/Honeypot.astro";
import { links, projectKinds } from "../data/site";


const paths = [
	{ id: "hiring", title: "I’m hiring for a role", sub: "Full-time, contract or interview request." },
	{ id: "business", title: "I want a website built", sub: "A site, app or dashboard for your business." },
];
---

<Layout
	title="Contact — Olawande Akinmosin"
	description="Get in touch with Olawande Akinmosin about a frontend role, or about a website, app or dashboard for your business."
	blobs={[
		{ color: "rgba(231,60,126,0.20)", size: "54vw", position: "top:-20vh;left:-12vw", duration: 24 },
		{ color: "rgba(35,166,213,0.18)", size: "50vw", position: "top:36vh;right:-16vw", duration: 30, reverse: true },
	]}
	nav={{ current: "contact", showStack: false }}
>
	<section class="section">
		<div class="wrap-sm contact">
			<div class="eyebrow">Contact</div>
			<h1>What brings you <span class="gradient-text">here?</span></h1>

			<div class="paths" role="radiogroup" aria-label="What brings you here?">
				{
					paths.map((p, i) => (
						<button
							type="button"
							role="radio"
							class:list={["path", p.id]}
							data-path={p.id}
							aria-checked={i === 0 ? "true" : "false"}
							tabindex={i === 0 ? 0 : -1}
						>
							<span class="path-head">
								<span class="radio" aria-hidden="true">
									<span />
								</span>
								<span class="path-title">{p.title}</span>
							</span>
							<span class="path-sub">{p.sub}</span>
						</button>
					))
				}
			</div>

			<div class="panel">
				<form
					action="/api/contact"
					method="POST"
					novalidate
					class="fade-in"
					data-path-form="hiring"
					aria-label="Hiring enquiry"
				>
					<input type="hidden" name="path" value="hiring" />
					<input type="hidden" name="source" value="/contact" />
					<Honeypot />
					<div class="fields">
						<Field idPrefix="hiring" label="Your name" name="name" placeholder="Amaka Bello" autocomplete="name" required />
						<Field idPrefix="hiring" label="Work email" name="email" type="email" placeholder="amaka@company.com" autocomplete="email" required />
						<Field idPrefix="hiring" label="Company" name="company" placeholder="Company name" autocomplete="organization" />
						<Field idPrefix="hiring" label="Role" name="role" placeholder="Senior Frontend Engineer" />
						<Field idPrefix="hiring" label="Type" name="type" type="select" options={["Full-time", "Contract", "Not decided"]} />
						<Field idPrefix="hiring" label="Job description link" name="jd" type="url" placeholder="https://" optional />
						<Field
							idPrefix="hiring"
							label="Message"
							name="message"
							type="textarea"
							full
							required
							placeholder="A bit about the team and what the role involves."
						/>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Send →</button>
						<a href={links.resume} download class="alt-link">Download résumé (PDF)</a>
					</div>
					<p class="form-error" data-form-error hidden role="alert">
						<span>
							Something went wrong. Email me at <a href={`mailto:${links.email}`}>{links.email}</a> instead.
						</span>
					</p>
				</form>

				<form
					action="/api/contact"
					method="POST"
					novalidate
					class="fade-in"
					data-path-form="business"
					aria-label="Business enquiry"
					hidden
				>
					<input type="hidden" name="path" value="business" />
					<input type="hidden" name="source" value="/contact" />
					<Honeypot />
					<div class="fields">
						<Field idPrefix="business" label="Your name" name="name" placeholder="Jane Okafor" autocomplete="name" required />
						<Field idPrefix="business" label="Email" name="email" type="email" placeholder="jane@okafor.co" autocomplete="email" required />
						<Field idPrefix="business" label="Business" name="business" placeholder="Okafor Interiors" autocomplete="organization" />
						<Field idPrefix="business" label="Kind of project" name="project" type="select" options={projectKinds} />
						<Field
							idPrefix="business"
							label="What should it do?"
							name="message"
							type="textarea"
							full
							required
							placeholder="Customers should be able to book a fitting online and pay a deposit. Right now it all happens over WhatsApp."
						/>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Send →</button>
						<a href="/work-with-me" class="alt-link mint">How I work with businesses →</a>
					</div>
					<p class="form-error" data-form-error hidden role="alert">
						<span>
							Something went wrong. Email me at <a href={`mailto:${links.email}`}>{links.email}</a> instead.
						</span>
					</p>
				</form>

				<div class="form-success fade-in" data-success-view hidden tabindex="-1">
					<div class="tick" aria-hidden="true">✓</div>
					<h2>Thanks. I’ll be in touch.</h2>
					<p>I read everything that comes through here myself.</p>
					<button type="button" class="btn btn-ghost" data-reset>Send another</button>
				</div>
			</div>

			<div class="prefer">
				<span>Prefer email?</span>
				<a href={`mailto:${links.email}`}>{links.email}</a>
				<a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
				<a href={links.github} target="_blank" rel="noopener">GitHub</a>
			</div>
		</div>
	</section>

	<footer class="section page-footer" slot="footer">
		<div class="wrap-sm footer-inner">
			<span>© 2026 Olawande Samuel Akinmosin</span>
			<span>Lagos, Nigeria · Open to remote &amp; relocation</span>
		</div>
	</footer>
</Layout>

<script>
	import { initForm } from "../scripts/forms";

	type Path = "hiring" | "business";

	const radios = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-path]"));
	const forms = Array.from(document.querySelectorAll<HTMLFormElement>("[data-path-form]"));
	const success = document.querySelector<HTMLElement>("[data-success-view]");
	let path: Path = "hiring";

	const formFor = (p: Path) => forms.find((f) => f.dataset.pathForm === p);

	const show = (next: Path, { updateHash = false, focus = false } = {}) => {
		path = next;
		radios.forEach((r) => {
			const on = r.dataset.path === next;
			r.setAttribute("aria-checked", String(on));
			r.tabIndex = on ? 0 : -1;
			if (on && focus) r.focus();
		});
		forms.forEach((f) => (f.hidden = f.dataset.pathForm !== next));
		if (success) success.hidden = true;
		if (updateHash) history.replaceState(null, "", `#${next}`);
	};

	const readHash = () => {
		const h = location.hash.replace("#", "");
		if (h === "hiring" || h === "business") show(h);
	};

	radios.forEach((r, i) => {
		r.addEventListener("click", () => show(r.dataset.path as Path, { updateHash: true }));
		// Arrow keys move between options, as in a native radio group.
		r.addEventListener("keydown", (e) => {
			if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
			e.preventDefault();
			const next = radios[(i + 1) % radios.length];
			show(next.dataset.path as Path, { updateHash: true, focus: true });
		});
	});

	forms.forEach((form) =>
		initForm(form, {
			onSuccess: () => {
				form.hidden = true;
				if (success) {
					success.hidden = false;
					success.focus();
				}
			},
		}),
	);

	success?.querySelector("[data-reset]")?.addEventListener("click", () => {
		show(path);
		formFor(path)?.querySelector<HTMLElement>(".input")?.focus();
	});

	readHash();
	window.addEventListener("hashchange", readHash);
</script>

<style>
	.contact {
		padding: 104px 0 112px;
	}

	.contact .eyebrow {
		margin-bottom: 28px;
	}

	h1 {
		font-size: clamp(40px, 5.4vw, 76px);
		line-height: 1.02;
		font-weight: 600;
		letter-spacing: -0.035em;
	}

	/* Path picker */
	.paths {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 48px;
	}

	.path {
		flex: 1 1 280px;
		display: block;
		text-align: left;
		padding: 24px 26px;
		border-radius: 12px;
		cursor: pointer;
		font: inherit;
		color: inherit;
		border: 1px solid oklch(1 0 0 / 0.1);
		background: oklch(0.178 0.008 300 / 0.6);
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease;
	}

	.path:hover {
		border-color: oklch(1 0 0 / 0.18);
	}

	.path[aria-checked="true"] {
		border-color: transparent;
		background:
			linear-gradient(oklch(0.2 0.012 300), oklch(0.2 0.012 300)) padding-box,
			var(--gradient) border-box;
	}

	.path-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.radio {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 2px solid var(--pink);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.business .radio {
		border-color: #23a6d5;
	}

	.radio span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--gradient);
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.path[aria-checked="true"] .radio span {
		opacity: 1;
	}

	.path-title {
		flex: 1;
		min-width: 0;
		font-size: 19px;
		line-height: 1.3;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.path-sub {
		display: block;
		margin-top: 8px;
		padding-left: 28px;
		font-size: 14.5px;
		line-height: 1.55;
		color: oklch(0.66 0.012 300);
	}

	/* Panel */
	.panel {
		margin-top: 28px;
		padding: 40px;
		border-radius: 16px;
		border: 1px solid oklch(1 0 0 / 0.1);
		background: oklch(0.178 0.008 300 / 0.85);
	}

	.alt-link {
		font-family: var(--font-mono);
		font-size: 13px;
	}

	.alt-link.mint {
		color: var(--mint);
	}

	.alt-link.mint:hover {
		color: var(--mint-light);
	}

	.form-success {
		padding: 16px 0;
		outline: none;
	}

	.form-success .tick {
		font-size: 30px;
		color: var(--pink);
	}

	.form-success h2 {
		margin-top: 18px;
		font-size: clamp(26px, 3vw, 36px);
	}

	.form-success p {
		margin-top: 14px;
	}

	.form-success .btn {
		margin-top: 28px;
	}

	.prefer {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		margin-top: 36px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: oklch(0.6 0.012 300);
	}

	/* Footer */
	.page-footer {
		border-top: 1px solid var(--border);
		padding-top: 40px;
		padding-bottom: 48px;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-faint);
	}

	@media (max-width: 640px) {
		.contact {
			padding: 88px 0 88px;
		}

		.panel {
			padding: 28px 20px;
		}

		.path {
			padding: 20px;
		}
	}
</style>
